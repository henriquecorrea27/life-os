DATABASE_URL="file:./dev.db"

# Pasta de backup. O padrão é "G:\Meu Drive\Life OS Backups" (Google Drive para
# Desktop), que sincroniza sozinho. Aponte para outro lugar se a letra do drive
# mudar ou se quiser guardar em outro serviço de sincronização.
# BACKUP_DIR="G:\Meu Drive\Life OS Backups"

# Desliga o backup automático após cada alteração (o `npm run backup` continua
# funcionando manualmente).
# BACKUP_AUTO=off
